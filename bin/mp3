#!/bin/bash

stderr() {
    printf '%s\n' "$*" >&2
}

run() {
    stderr '❯' "$@"
    "$@"
}

# URL is required
URL="$1"
if [ -z "$URL" ]; then
    echo "Must specify a url"
    exit 1
fi

if ! check_dep "yt-dlp"; then
    stderr "❌ yt-dlp is required but was not found on PATH."
    stderr
    stderr "Github"
    stderr "https://github.com/yt-dlp/yt-dlp#release-files"
    stderr
    stderr '  mkdir -p "$HOME/.local/bin"'
    stderr '  mv "$HOME/Downloads/yt-dlp_macos" "$HOME/.local/bin/yt-dlp"'
    stderr '  chmod a+rx "$HOME/.local/bin/yt-dlp"'
    stderr '  xattr -d com.apple.quarantine "$HOME/.local/bin/yt-dlp" 2>/dev/null || true'
    stderr '  yt-dlp --version'
    stderr
    stderr "Homebrew"
    stderr
    stderr "  brew install yt-dlp"
    stderr
    exit 1
fi

output="$HOME/Downloads/%(title)s.%(ext)s"

# first try to download m4a/mp3 audio format
if run yt-dlp -k -f "bestaudio[ext=m4a]/bestaudio[ext=mp3]" -o "$output" "$URL"; then
    exit 0
fi

stderr
stderr "⚠️ Failed to download m4a/mp3 audio format"
stderr "Trying to extract mp3 instead…"
stderr

# use built-in audio extraction
run yt-dlp -x --audio-format mp3 --audio-quality 0 --no-playlist -o "$output" "$URL"
